<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="5.0" method="upgrade">
    <name>COM_PHOTOORDERS</name>
    <author>Benjamin Buenrostro</author>
    <creationDate>2026</creationDate>
    <copyright>Copyright (C) 2026. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@example.com</authorEmail>
    <authorUrl>www.example.com</authorUrl>
    <version>1.0.0</version>
    <description>COM_PHOTOORDERS_XML_DESCRIPTION</description>

    <!-- Namespace definition for PSR-4 autoloading in Joomla 4/5/6 -->
    <namespace path="src">YourVendor\Component\Photoorders</namespace>

    <!-- Database installation scripts -->
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <uninstall>
        <sql>
            <file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
        </sql>
    </uninstall>

    <!-- Site / Frontend Files -->
    <!-- Copy the entire src folder into the component root -->
    <files folder="src">
        <folder>Controller</folder>
        <folder>Extension</folder>
        <folder>field</folder>
        <folder>Helper</folder>
        <folder>Model</folder>
        <folder>Table</folder>
        <folder>View</folder>
    </files>

    <!-- Administration / Backend Files & Navigation -->
    <administration>
        <menu link="option=com_photoorders">COM_PHOTOORDERS</menu>
        <submenu>
            <menu link="option=com_photoorders&amp;view=albums">COM_PHOTOORDERS_SUBMENU_ALBUMS</menu>
            <menu link="option=com_photoorders&amp;view=reports">COM_PHOTOORDERS_SUBMENU_REPORTS</menu>
        </submenu>

        <!-- Correct tag for single service provider file -->
        <files folder="services">
            <filename>provider.php</filename>
        </files>
    </administration>
</extension>