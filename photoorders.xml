<?xml version="1.0" encoding="utf-8"?>
<extension type="component" version="5.0" method="upgrade">
    <name>COM_PHOTOORDERS</name>
    <author>Your Name</author>
    <creationDate>September 2026</creationDate>
    <version>1.0.0</version>
    <description>Photo Client Ordering System for Joomla 6</description>

    <namespace path="src">YourVendor\Component\Photoorders</namespace>

    <files folder="src">
        <folder>Controller</folder>
        <folder>Extension</folder>
        <folder>Model</folder>
        <folder>View</folder>
    </files>

    <services>
        <service file="services/provider.php"/>
    </services>

    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>

    <administration>
        <menu link="option=com_photoorders">Photo Orders</menu>
        <submenu>
            <menu link="option=com_photoorders&amp;view=albums">Albums</menu>
            <menu link="option=com_photoorders&amp;view=orders">Orders Report</menu>
        </submenu>
    </administration>
</extension>